# FRED API key — free at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# Optional: e-Stat (Japan Statistics Bureau) app ID — free at
# https://www.e-stat.go.jp/api/  (enables live Japan CPI; JP falls back to
# World-Bank data when this is absent)
ESTAT_APP_ID=your_estat_app_id_here
